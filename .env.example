# Frontend configuration
# API is the default; set this to mock only for explicit demo/test mode.
VITE_DATA_MODE=api
VITE_APP_NAME=APIx
VITE_API_BASE_URL=http://localhost:8000

# Optional public client configuration for live integrations
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend configuration
APP_NAME=APIx
APP_ENV=development
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATA_MODE=api
# Must be a JSON array string so pydantic-settings can parse it into list[str].
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apix

# Keep server-only provider credentials in the backend environment. Never expose them to Vite.
