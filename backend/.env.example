APP_NAME=APIx
APP_ENV=development
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATA_MODE=api
# Must be a JSON array string so pydantic-settings can parse it into list[str].
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apix
FLIGHTAPI_BASE_URL=https://api.flightapi.io
# FLIGHTAPI_API_KEY must be supplied through a server-only secret/environment variable.
POSTGRES_DB=apix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FLIGHTAPI_API_KEY=
FLIGHTAPI_BASE_URL=https://api.flightapi.io
